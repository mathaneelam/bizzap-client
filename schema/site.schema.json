{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bizzap Local Sites — site.json",
  "type": "object",
  "required": ["schema_version", "slug", "template", "meta", "theme", "contact", "sections", "seo", "source"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "template": { "type": "string", "enum": ["manufacturer", "shop", "clinic", "food", "services"] },

    "meta": {
      "type": "object",
      "required": ["name", "category", "tagline", "description"],
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "tagline": { "type": "string" },
        "description": { "type": "string" },
        "locale": { "type": "array", "items": { "type": "string" }, "default": ["en"] }
      }
    },

    "theme": {
      "type": "object",
      "required": ["primary", "accent", "font_head", "font_body"],
      "properties": {
        "preset": { "type": "string" },
        "primary": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "font_head": { "type": "string" },
        "font_body": { "type": "string" },
        "logo": { "type": "string" }
      }
    },

    "contact": {
      "type": "object",
      "required": ["phone", "address"],
      "properties": {
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "geo": {
          "type": "object",
          "properties": { "lat": { "type": "number" }, "lng": { "type": "number" } }
        },
        "hours": { "type": "object" },
        "gbp_url": { "type": "string" },
        "socials": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string" },
            "facebook": { "type": "string" }
          }
        }
      }
    },

    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["hero", "about", "catalog", "capabilities", "gallery", "testimonials", "contact"]
          }
        }
      }
    },

    "seo": {
      "type": "object",
      "required": ["title", "meta_description"],
      "properties": {
        "title": { "type": "string", "maxLength": 60 },
        "meta_description": { "type": "string", "maxLength": 160 },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "localbusiness_jsonld": { "type": "boolean", "default": true }
      }
    },

    "source": {
      "type": "object",
      "required": ["generated_by", "human_approved"],
      "properties": {
        "place_ref": { "type": "string" },
        "scraped_at": { "type": "string" },
        "reviews_used": { "type": "integer" },
        "generated_by": { "type": "string", "enum": ["claude-manual", "claude-sonnet-5-api", "human"] },
        "human_approved": { "type": "boolean", "default": false }
      }
    }
  }
}
