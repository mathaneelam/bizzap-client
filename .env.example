# Bizzap Pipeline Configuration

# Supabase PostgreSQL Connection String
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
# Example: postgresql://postgres.abcdefghijklmnop:secretpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=

# Cloudflare API Token (for automatic pages deployment)
# Create a token under My Profile -> API Tokens -> Create Custom Token
# Permissions: Account -> Cloudflare Pages -> Edit, Account -> Members -> Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
